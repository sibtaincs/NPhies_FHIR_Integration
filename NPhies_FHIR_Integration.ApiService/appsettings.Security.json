{
  "App": {
    "Name": "NPhies FHIR Integration",
    "Version": "1.0.0",
    "IsDevelopment": true,
    "IsProduction": false,
    "Environment": "Development"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-that-is-at-least-32-characters-long-for-security-change-this-in-production",
    "Issuer": "NPhiesIssuer",
    "Audience": "NPhiesAudience",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "SecuritySettings": {
    "PasswordPolicy": {
    "MinimumLength": 12,
      "RequireUppercase": true,
    "RequireLowercase": true,
      "RequireNumbers": true,
      "RequireSpecialCharacters": true,
   "SpecialCharacterCount": 1,
      "MaximumConsecutiveCharacters": 3,
      "MaximumRepeatingCharacters": 2,
      "PasswordHistoryCount": 5,
      "MaximumPasswordAgeDays": 90,
   "MinimumPasswordAgeDays": 1
    },
    "SecurityHeaders": {
      "EnableHsts": true,
      "HstsMaxAge": 31536000,
      "HstsIncludeSubdomains": true,
      "HstsPreload": true,
   "EnableCsp": true,
      "CspPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;",
      "XFrameOptions": "DENY",
      "XContentTypeOptions": "nosniff",
 "ReferrerPolicy": "strict-origin-when-cross-origin",
      "PermissionsPolicy": "geolocation=(), microphone=(), camera=()"
    },
    "Cors": {
      "AllowedOrigins": [ "http://localhost:4200", "http://localhost:3000" ],
"AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-Requested-With" ],
      "ExposedHeaders": [ "X-Total-Count", "X-Page-Number" ],
      "AllowCredentials": true,
  "MaxAge": 3600
    },
    "IpFilter": {
      "EnableWhitelist": false,
    "EnableBlacklist": false,
      "WhitelistedIps": [ "127.0.0.1", "::1" ],
      "BlacklistedIps": [],
      "WhitelistedRanges": [],
      "BlacklistedRanges": []
    },
    "RateLimiting": {
      "DefaultLimit": 100,
   "DefaultWindowSeconds": 60,
 "StrictLimit": 10,
      "StrictWindowSeconds": 60
    },
    "Session": {
      "TimeoutMinutes": 30,
      "AbsoluteTimeoutMinutes": 480,
      "IdleTimeoutMinutes": 30
    },
    "Encryption": {
      "EnableEncryption": true,
      "EncryptionProvider": "AES",
      "KeySize": 256,
      "FieldsToEncrypt": [
        "Email",
        "PhoneNumber",
        "SocialSecurityNumber",
   "PatientId",
        "ProviderId"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "NPhies_FHIR_Integration": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NPhiesDb;Trusted_Connection=true;"
  },
  "AllowedHosts": "*"
}
