{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "NPhies_FHIR_Integration.Infrastructure.Seeding": "Debug",
      "NPhies_FHIR_Integration.Application.Services": "Debug"
    }
  },
  "Nphies": {
    "BaseUrl": "https://sandbox.nphies.sa/api/fhir",
    "Timeout": 60,
    "EnableDetailedLogging": true,
    "Auth": {
      "Authority": "https://sandbox-auth.nphies.sa",
      "ClientId": "dev-client-id",
      "ClientSecret": "dev-client-secret"
    }
  }
}
